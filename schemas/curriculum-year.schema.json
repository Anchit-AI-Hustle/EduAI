{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "curriculum-year.schema.json",
  "title": "Curriculum year skeleton (one board, one year)",
  "description": "Every year has its own plan. Content marked basis=product-default is a design choice, not board syllabus. Board facts must cite source_ids.",
  "type": "object",
  "$defs": {
    "sourceIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^SRC-[A-Z0-9-]+$"
      }
    },
    "status": {
      "enum": [
        "sourced",
        "partially-sourced",
        "skeleton",
        "gap",
        "not-applicable"
      ]
    },
    "basis": {
      "enum": [
        "board-mandated",
        "national-framework",
        "product-default",
        "not-yet-sourced"
      ]
    },
    "block": {
      "type": "object",
      "required": [
        "status",
        "basis"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/status"
        },
        "basis": {
          "$ref": "#/$defs/basis"
        },
        "source_ids": {
          "$ref": "#/$defs/sourceIds"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "skeleton_id",
    "board_id",
    "year_id",
    "academic_session",
    "nep_stage",
    "coverage_status",
    "subjects",
    "skills",
    "term_plan",
    "weekly_plan",
    "daily_lesson_template",
    "assessments",
    "co_curricular",
    "extracurricular",
    "parent_view",
    "scheme_notes",
    "source_ids",
    "gaps"
  ],
  "properties": {
    "skeleton_id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "board_id": {
      "enum": [
        "national-early-years",
        "cbse",
        "cisce",
        "nios",
        "state-boards"
      ]
    },
    "year_id": {
      "type": "string",
      "pattern": "^(home-0-3|nursery|lkg|ukg|class-(0[1-9]|1[0-2]))$"
    },
    "academic_session": {
      "type": "string"
    },
    "nep_stage": {
      "enum": [
        "pre-foundational-home",
        "foundational",
        "preparatory",
        "middle",
        "secondary"
      ]
    },
    "coverage_status": {
      "enum": [
        "sourced",
        "partially-sourced",
        "gap",
        "defers-to-national-framework",
        "not-offered-by-board"
      ]
    },
    "certification_point": {
      "type": [
        "string",
        "null"
      ]
    },
    "scheme_notes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "text",
          "source_ids"
        ],
        "properties": {
          "text": {
            "type": "string"
          },
          "source_ids": {
            "$ref": "#/$defs/sourceIds",
            "minItems": 1
          }
        }
      }
    },
    "subjects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "subject_id",
          "name_en",
          "name_hi",
          "skill_ids",
          "status",
          "source_ids"
        ],
        "properties": {
          "subject_id": {
            "type": "string"
          },
          "name_en": {
            "type": "string"
          },
          "name_hi": {
            "type": "string"
          },
          "name_hi_basis": {
            "enum": [
              "ui-translation",
              "official"
            ]
          },
          "skill_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          "ncert_textbook_titles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "language_slot": {
            "enum": [
              "R1",
              "R2",
              "R3",
              "R1-or-R2",
              "any",
              null
            ]
          },
          "status": {
            "$ref": "#/$defs/status"
          },
          "source_ids": {
            "$ref": "#/$defs/sourceIds"
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "ncert_hindi_medium_titles": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "skill_id",
          "depth"
        ],
        "properties": {
          "skill_id": {
            "type": "string"
          },
          "depth": {
            "enum": [
              "domain-only",
              "units",
              "competencies"
            ]
          }
        }
      }
    },
    "term_plan": {
      "allOf": [
        {
          "$ref": "#/$defs/block"
        }
      ],
      "required": [
        "terms"
      ],
      "properties": {
        "terms": {
          "type": "array"
        }
      }
    },
    "weekly_plan": {
      "allOf": [
        {
          "$ref": "#/$defs/block"
        }
      ],
      "required": [
        "weeks_per_year",
        "sessions_per_week"
      ]
    },
    "daily_lesson_template": {
      "allOf": [
        {
          "$ref": "#/$defs/block"
        }
      ],
      "required": [
        "loop",
        "screen_minutes_cap"
      ]
    },
    "assessments": {
      "type": "object",
      "required": [
        "unit_tests",
        "internals",
        "term_exams",
        "board_style_mocks"
      ],
      "properties": {
        "unit_tests": {
          "$ref": "#/$defs/block"
        },
        "internals": {
          "$ref": "#/$defs/block"
        },
        "term_exams": {
          "$ref": "#/$defs/block"
        },
        "board_style_mocks": {
          "allOf": [
            {
              "$ref": "#/$defs/block"
            }
          ],
          "required": [
            "applicable"
          ]
        }
      }
    },
    "co_curricular": {
      "allOf": [
        {
          "$ref": "#/$defs/block"
        }
      ],
      "required": [
        "areas"
      ]
    },
    "extracurricular": {
      "allOf": [
        {
          "$ref": "#/$defs/block"
        }
      ],
      "required": [
        "areas"
      ]
    },
    "parent_view": {
      "allOf": [
        {
          "$ref": "#/$defs/block"
        }
      ],
      "required": [
        "sections"
      ]
    },
    "source_ids": {
      "$ref": "#/$defs/sourceIds"
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "gap_id",
          "missing",
          "resolve_from",
          "phase"
        ],
        "properties": {
          "gap_id": {
            "type": "string"
          },
          "missing": {
            "type": "string",
            "minLength": 10
          },
          "resolve_from": {
            "type": "string",
            "minLength": 5
          },
          "phase": {
            "enum": [
              "phase-1",
              "phase-2",
              "phase-3",
              "phase-4"
            ]
          }
        }
      }
    },
    "generated_by": {
      "type": "string"
    },
    "built_on": {
      "type": "string"
    }
  }
}
