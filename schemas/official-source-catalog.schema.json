{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://everyyear.school/schemas/official-source-catalog.schema.json",
  "title": "EveryYear Official Source Catalog Schema",
  "description": "Registry of official statutory, curriculum, and examination authorities used to ground all syllabus, policy, and assessment artifacts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "updatedAt", "sources"],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "sources": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourceId",
          "authority",
          "title",
          "officialUrl",
          "category",
          "publishedYear",
          "verifiedAt",
          "verificationStatus",
          "scopeNotes"
        ],
        "properties": {
          "sourceId": {
            "type": "string",
            "pattern": "^SRC-[A-Z0-9-]+$"
          },
          "authority": {
            "type": "string",
            "minLength": 2
          },
          "title": {
            "type": "string",
            "minLength": 5
          },
          "officialUrl": {
            "type": "string",
            "format": "uri"
          },
          "category": {
            "enum": [
              "early-years-framework",
              "national-curriculum-framework",
              "school-board-syllabus",
              "open-schooling",
              "competitive-exam-india",
              "study-abroad-exam",
              "credit-and-assessment-framework",
              "legal-and-child-safety",
              "education-statistics"
            ]
          },
          "publishedYear": {
            "type": "integer",
            "minimum": 2009,
            "maximum": 2027
          },
          "verifiedAt": {
            "type": "string",
            "format": "date"
          },
          "verificationStatus": {
            "enum": ["verified-primary-source", "verified-portal-with-chapter-gaps"]
          },
          "scopeNotes": {
            "type": "string",
            "minLength": 10
          }
        }
      }
    }
  }
}
