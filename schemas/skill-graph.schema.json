{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://everyyear.school/schemas/skill-graph.schema.json",
  "title": "EveryYear Shared Skill Graph Schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "graphVersion",
    "updatedAt",
    "domains",
    "skills",
    "edges",
    "provenance"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "graphVersion": {
      "type": "string"
    },
    "updatedAt": {
      "type": "string"
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "en"
            ],
            "properties": {
              "en": {
                "type": "string"
              },
              "hi": {
                "type": "string"
              }
            }
          },
          "description": {
            "type": "string"
          },
          "parentDomainId": {
            "type": "string"
          }
        }
      }
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "domainId",
          "stage",
          "description",
          "successCriteria",
          "evidenceTypes",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "en"
            ],
            "properties": {
              "en": {
                "type": "string"
              },
              "hi": {
                "type": "string"
              }
            }
          },
          "domainId": {
            "type": "string"
          },
          "stage": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "fromYearId",
              "toYearId"
            ],
            "properties": {
              "fromYearId": {
                "type": "string"
              },
              "toYearId": {
                "type": "string"
              }
            }
          },
          "description": {
            "type": "string"
          },
          "prerequisites": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "successCriteria": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "evidenceTypes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "boardAlignments": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "trackBranches": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "status": {
            "enum": [
              "active",
              "draft",
              "deprecated",
              "merged"
            ]
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from",
          "to",
          "type"
        ],
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "strength": {
            "type": "string"
          }
        }
      }
    },
    "coverageSummary": {
      "type": "object"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authoredBy",
        "reviewStatus",
        "license"
      ],
      "properties": {
        "authoredBy": {
          "type": "string"
        },
        "reviewedBy": {
          "type": "string"
        },
        "reviewStatus": {
          "type": "string"
        },
        "license": {
          "type": "string"
        },
        "updatedFromCurriculumVersions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
