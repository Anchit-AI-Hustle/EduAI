{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://everyyear.school/schemas/learner-profile.schema.json",
  "title": "EveryYear Learner Profile Schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "learnerId",
    "createdAt",
    "education",
    "preferences",
    "consent",
    "privacy"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "learnerId": {
      "type": "string",
      "pattern": "^[a-z0-9]{10,32}$"
    },
    "createdAt": {
      "type": "string"
    },
    "updatedAt": {
      "type": "string"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "preferredName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "dateOfBirth": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}(-\\d{2})?$"
        },
        "guardianContactRef": {
          "type": "string",
          "minLength": 6
        }
      }
    },
    "education": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "currentYearId",
        "boardId",
        "languages"
      ],
      "properties": {
        "currentYearId": {
          "enum": [
            "home-0-3",
            "nursery",
            "lkg",
            "ukg",
            "class-01",
            "class-02",
            "class-03",
            "class-04",
            "class-05",
            "class-06",
            "class-07",
            "class-08",
            "class-09",
            "class-10",
            "class-11",
            "class-12"
          ]
        },
        "boardId": {
          "enum": [
            "early-years",
            "cbse",
            "cisce",
            "nios",
            "state-boards"
          ]
        },
        "stateBoardId": {
          "type": "string"
        },
        "schoolType": {
          "enum": [
            "school-enrolled",
            "home-learning",
            "open-schooling",
            "hybrid",
            "unverified"
          ]
        },
        "completedYearIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "languages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "role"
            ],
            "properties": {
              "code": {
                "enum": [
                  "en",
                  "hi",
                  "other"
                ]
              },
              "otherLabel": {
                "type": "string"
              },
              "role": {
                "enum": [
                  "medium",
                  "first-language",
                  "second-language",
                  "third-language"
                ]
              }
            }
          }
        },
        "priorBoardIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mediumOfInstruction": {
          "enum": [
            "en",
            "hi",
            "bilingual",
            "other"
          ]
        }
      }
    },
    "goals": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "targetTracks": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "jee",
              "neet",
              "cuet",
              "upsc",
              "sat",
              "act",
              "ielts",
              "toefl"
            ]
          }
        },
        "targetExamYear": {
          "type": "integer",
          "minimum": 2026,
          "maximum": 2045
        },
        "weeklyStudyMinutes": {
          "type": "integer",
          "minimum": 30,
          "maximum": 3600
        },
        "notes": {
          "type": "string",
          "maxLength": 500
        }
      }
    },
    "preferences": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uiLanguage"
      ],
      "properties": {
        "uiLanguage": {
          "enum": [
            "en",
            "hi"
          ]
        },
        "contentLanguageMix": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "explanation": {
              "enum": [
                "en",
                "hi",
                "both"
              ]
            },
            "practice": {
              "enum": [
                "en",
                "hi",
                "both"
              ]
            }
          }
        },
        "sessionLengthMinutes": {
          "type": "integer",
          "minimum": 5,
          "maximum": 90
        },
        "offlineFirst": {
          "type": "boolean"
        },
        "parentViewEnabled": {
          "type": "boolean"
        },
        "reducedMotion": {
          "type": "boolean"
        }
      }
    },
    "consent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "policyVersion"
      ],
      "properties": {
        "status": {
          "enum": [
            "not-required",
            "guardian-pending",
            "guardian-verified",
            "guardian-declined",
            "withdrawn"
          ]
        },
        "policyVersion": {
          "type": "string"
        },
        "consentedAt": {
          "type": "string"
        },
        "guardianRelationship": {
          "enum": [
            "parent",
            "legal-guardian",
            "other"
          ]
        },
        "verificationMethod": {
          "enum": [
            "school-attestation",
            "digilocker",
            "payment-instrument",
            "in-person",
            "other"
          ]
        },
        "jurisdiction": {
          "enum": [
            "IN"
          ]
        },
        "dataProcessingConsent": {
          "type": "boolean"
        },
        "mediaConsent": {
          "type": "boolean"
        }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataResidency",
        "retentionClass",
        "analyticsOptOut"
      ],
      "properties": {
        "dataResidency": {
          "const": "IN"
        },
        "retentionClass": {
          "enum": [
            "session",
            "one-year",
            "until-withdrawal",
            "legal-minimum"
          ]
        },
        "analyticsOptOut": {
          "type": "boolean"
        },
        "thirdPartyAiProcessingAllowed": {
          "type": "boolean"
        },
        "exportRequestedAt": {
          "type": "string"
        },
        "deletionRequestedAt": {
          "type": "string"
        }
      }
    },
    "diagnosticState": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lastDiagnosticId": {
          "type": "string"
        },
        "lastDiagnosticAt": {
          "type": "string"
        },
        "confidence": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "masterySummary": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "skillId",
              "mastery",
              "evidenceCount"
            ],
            "properties": {
              "skillId": {
                "type": "string"
              },
              "mastery": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "evidenceCount": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "planState": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "activePlanId": {
          "type": "string"
        },
        "curriculumVersion": {
          "type": "string"
        },
        "planRevision": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "accessibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "accommodations": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "screenTimeCapMinutesPerDay": {
          "type": "integer",
          "minimum": 0,
          "maximum": 480
        }
      }
    }
  }
}
