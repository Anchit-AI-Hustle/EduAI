{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "official-source-register.schema.json",
  "title": "Official source register",
  "type": "object",
  "required": ["register_id", "compiled_on", "sources"],
  "properties": {
    "register_id": { "type": "string" },
    "compiled_on": { "type": "string", "format": "date" },
    "verification_status_legend": { "type": "object" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_id", "title", "issuing_body", "url", "type", "retrieved_on", "verification_status", "supports"],
        "properties": {
          "source_id": { "type": "string", "pattern": "^SRC-[A-Z0-9-]+$" },
          "title": { "type": "string", "minLength": 5 },
          "issuing_body": { "type": "string" },
          "url": { "type": "string", "pattern": "^https://" },
          "type": { "enum": ["primary-official", "secondary-reported"] },
          "retrieved_on": { "type": "string", "format": "date" },
          "verification_status": { "enum": ["fetched-and-read", "read-via-search-index", "snapshot-stored", "referenced-not-ingested", "blocked-from-build-environment", "secondary-only"] },
          "supports": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "notes": { "type": "string" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
